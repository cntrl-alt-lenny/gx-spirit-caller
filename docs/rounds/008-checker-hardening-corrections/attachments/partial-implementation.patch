+++ b/tools/semantic_fake_matches.py
@@ -0,0 +1,224 @@
+"""Compiler AST analysis for do-while-zero and volatile-local.
+
+libclang 18 targets ARMv5TE, signed char, int enums, freestanding C/C++.
+Metrowerks assembly bodies and placement attributes are blanked preserving
+lines; the separate lexical/object rules still inspect the original bytes.
+Syntax/type errors and missing dependencies fail closed. Each preprocessor
+arm in a source unit is also parsed (including inactive sources); excessive
+configuration combinations fail closed instead of silently truncating them.
+"""
+from __future__ import annotations
+
+from ctypes import c_double, c_int, c_longlong, c_void_p
+from itertools import product
+from pathlib import Path
+import re
+
+from progress import _strip_c_comments_and_literals
+
+
+class AnalysisError(ValueError):
+    pass
+
+
+def _blank(chars: list[str], a: int, b: int) -> None:
+    for i in range(a, b):
+        if chars[i] != '\n':
+            chars[i] = ' '
+
+
+def adapt(source: str) -> str:
+    """Only erase foreign asm syntax and placement attributes, never C bodies."""
+    from check_fake_matches import _blank_preprocessor, _function_body_spans
+    clean = _strip_c_comments_and_literals(source)
+    if re.search(r"(?m)^\s*#\s*define\s+(?:asm|__declspec)\b", clean):
+        raise AnalysisError("macro redefines a syntax-adapter keyword")
+    clean = _blank_preprocessor(clean)
+    out = list(source)
+    for a, b in _function_body_spans(clean):
+        # A top-level asm function has an asm keyword in its declaration.
+        declaration = clean[max(clean.rfind(';', 0, a), clean.rfind('}', 0, a)) + 1:a]
+        if re.fullmatch(r'\s*asm\s+[^;{}]+', declaration):
+            start = list(re.finditer(r'\basm\b', clean[:a]))[-1].start()
+            _blank(out, start, start + 3)
+            _blank(out, a + 1, b - 1)
+    for m in re.finditer(r'\b(?:asm|__declspec)\s*[{(]', clean):
+        start = m.end() - 1
+        closing = '}' if clean[start] == '{' else ')'
+        opening = clean[start]
+        depth = 1
+        end = start + 1
+        while end < len(clean) and depth:
+            depth += (clean[end] == opening) - (clean[end] == closing)
+            end += 1
+        if depth:
+            raise AnalysisError('unterminated asm or placement attribute')
+        # GNU asm("...") is valid C syntax. Only mwcc block asm is erased.
+        if m.group().startswith('asm') and opening == '(':
+            continue
+        _blank(out, m.start(), end)
+        if opening == '{':
+            out[m.start()] = ';'
+    return ''.join(out)
+
+
+def variants(source: str) -> list[str]:
+    """Original configuration plus all source conditional-arm combinations."""
+    clean = _strip_c_comments_and_literals(source)
+    directives = list(re.finditer(r'(?m)^[ \t]*#[ \t]*(if|ifdef|ifndef|elif|else|endif)\b[^\n]*', clean))
+    groups: list[list] = []
+    stack: list[int] = []
+    owners = {}
+    for m in directives:
+        kind = m.group(1)
+        if kind in ('if', 'ifdef', 'ifndef'):
+            stack.append(len(groups))
+            groups.append([m])
+        elif kind in ('elif', 'else'):
+            if not stack:
+                raise AnalysisError('unbalanced preprocessor conditional')
+            groups[stack[-1]].append(m)
+        elif not stack:
+            raise AnalysisError('unbalanced preprocessor conditional')
+        else:
+            stack.pop()
+        if kind != 'endif':
+            owners[m.start()] = stack[-1]
+    if stack:
+        raise AnalysisError('unbalanced preprocessor conditional')
+    combinations = 1
+    for g in groups:
+        combinations *= len(g)
+    if combinations > 64:
+        raise AnalysisError('more than 64 conditional configurations; analysis refused')
+    results = [source]
+    for choices in product(*(range(len(g)) for g in groups)):
+        chars = list(source)
+        for m in directives:
+            kind = m.group(1)
+            if kind in ('else', 'endif'):
+                continue
+            group = groups[owners[m.start()]]
+            enabled = group.index(m) == choices[owners[m.start()]]
+            replacement = ('#if ' if kind != 'elif' else '#elif ') + str(int(enabled))
+            # Preserve offsets and line numbers for diagnostics and baseline keys.
+            chars[m.start():m.end()] = list(replacement.ljust(m.end() - m.start()))
+        result = ''.join(chars)
+        if result not in results:
+            results.append(result)
+    return results
+
+
+class Analyzer:
+    def __init__(self, root: Path):
+        try:
+            from clang import cindex as c
+            self.c = c
+            self.index = c.Index.create()
+            lib = c.conf.lib
+            for name, args, result in (
+                ('clang_Cursor_Evaluate', [c.Cursor], c_void_p),
+                ('clang_EvalResult_getKind', [c_void_p], c_int),
+                ('clang_EvalResult_getAsLongLong', [c_void_p], c_longlong),
+                ('clang_EvalResult_getAsDouble', [c_void_p], c_double),
+                ('clang_EvalResult_dispose', [c_void_p], None),
+            ):
+                fn = getattr(lib, name)
+                fn.argtypes, fn.restype = args, result
+            self.lib = lib
+        except Exception as exc:
+            raise AnalysisError(f'libclang unavailable: {exc}') from exc
+        self.root = root.resolve()
+        includes = [self.root / 'include'] + sorted((self.root / 'libs').glob('*/include'))
+        self.args = ['-target', 'armv5te-none-eabi', '-ffreestanding', '-fdeclspec',
+                     '-fsigned-char', '-Wno-everything'] + ['-I' + str(p) for p in includes]
+        self.headers = []
+        for top in ('include', 'src', 'libs'):
+            for p in sorted((self.root / top).rglob('*')):
+                if p.suffix in ('.h', '.hpp', '.inc') and p.is_file():
+                    text = p.read_text(encoding='utf-8', errors='strict')
+                    self.headers.append((str(p), adapt(text)))
+
+    def parse(self, path: Path, source: str):
+        region = 'JPN' if 'jpn' in path.parts else 'USA' if 'usa' in path.parts else 'EUR'
+        cpp = path.suffix == '.cpp'
+        args = self.args + ['-x', 'c++' if cpp else 'c', '-std=gnu++98' if cpp else '-std=gnu99',
+                            '-D' + region]
+        try:
+            tu = self.index.parse(str(path), args=args, unsaved_files=self.headers + [(str(path), source)])
+        except Exception as exc:
+            raise AnalysisError(f'{path.relative_to(self.root)}: parser failed: {exc}') from exc
+        errors = [f'{d.location.line}:{d.location.column}: {d.spelling}' for d in tu.diagnostics
+                  if d.severity >= self.c.Diagnostic.Error]
+        if errors:
+            raise AnalysisError(f'{path.relative_to(self.root)}: ' + '; '.join(errors))
+        return tu
+
+    def constant_false(self, expr) -> bool:
+        result = self.lib.clang_Cursor_Evaluate(expr)
+        if not result:
+            # A well-typed expression with no compile-time value is a real
+            # runtime condition, not an input or parser error.
+            return False
+        try:
+            kind = self.lib.clang_EvalResult_getKind(result)
+            if kind == 1:
+                return self.lib.clang_EvalResult_getAsLongLong(result) == 0
+            if kind == 2:
+                return self.lib.clang_EvalResult_getAsDouble(result) == 0.0
+            raise AnalysisError(f'unsupported constant evaluation kind {kind}')
+        finally:
+            self.lib.clang_EvalResult_dispose(result)
+
+    def scan(self, rel: str, source: str) -> list[tuple[str, int]]:
+        path = self.root / rel
+        results = set()
+        for variant in variants(source):
+            prepared = adapt(variant)
+            tu = self.parse(path, prepared)
+            # Convert conditions to boolean in their original scope. Clang's
+            # evaluator otherwise cannot expose a null pointer value (NULL).
+            edits = []
+            for node in tu.cursor.walk_preorder():
+                if node.kind == self.c.CursorKind.DO_STMT and node.location.file \
+                        and Path(node.location.file.name) == path:
+                    # Statement macro wrappers remain exempt, as before. A
+                    # macro used only for the condition is NOT exempt.
+                    if prepared.encode('utf-8')[node.extent.start.offset:node.extent.start.offset + 2] != b'do':
+                        continue
+                    expr = list(node.get_children())[-1]
+                    a, b = expr.extent.start.offset, expr.extent.end.offset
+                    if not expr.extent.start.file or Path(expr.extent.start.file.name) != path or b <= a:
+                        raise AnalysisError(f'{rel}: cannot locate do-while condition')
+                    edits.extend([(a, '!!('), (b, ')')])
+            for offset, text in sorted(edits, reverse=True):
+                data = prepared.encode('utf-8')
+                prepared = (data[:offset] + text.encode('utf-8') + data[offset:]).decode('utf-8')
+            if edits:
+                tu = self.parse(path, prepared)
+            for node in tu.cursor.walk_preorder():
+                if not node.location.file or Path(node.location.file.name) != path:
+                    continue
+                if node.kind == self.c.CursorKind.DO_STMT:
+                    if prepared.encode('utf-8')[node.extent.start.offset:node.extent.start.offset + 2] != b'do':
+                        continue
+                    expr = list(node.get_children())[-1]
+                    if self.constant_false(expr):
+                        results.add(('do-while-zero', expr.location.line))
+                elif node.kind == self.c.CursorKind.VAR_DECL:
+                    # Parameters, file-scope objects, fields, and extern
+                    # references are not local objects. Arrays inherit their
+                    # element's qualification; pointer pointees do not.
+                    parent = node.semantic_parent
+                    if parent.kind not in (self.c.CursorKind.FUNCTION_DECL, self.c.CursorKind.CXX_METHOD,
+                                           self.c.CursorKind.LAMBDA_EXPR):
+                        continue
+                    if node.storage_class == self.c.StorageClass.EXTERN:
+                        continue
+                    type_ = node.type.get_canonical()
+                    while type_.kind in (self.c.TypeKind.CONSTANTARRAY, self.c.TypeKind.INCOMPLETEARRAY,
+                                         self.c.TypeKind.VARIABLEARRAY):
+                        type_ = type_.element_type.get_canonical()
+                    if type_.is_volatile_qualified():
+                        results.add(('volatile-local', node.extent.start.line))
+        return sorted(results, key=lambda r: (r[1], r[0]))
