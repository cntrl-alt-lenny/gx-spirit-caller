+"""Execute the actual base-tree CLI against proposed commits, including removal."""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class TestTrustedFactory(unittest.TestCase):
+    def test_base_decision_survives_proposed_attacks(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            env = dict(os.environ, GIT_AUTHOR_NAME='Test', GIT_AUTHOR_EMAIL='test' + chr(64) + 'example.invalid',
+                       GIT_COMMITTER_NAME='Test', GIT_COMMITTER_EMAIL='test' + chr(64) + 'example.invalid')
+
+            def git(*args):
+                return subprocess.check_output(['git', *args], cwd=root, env=env,
+                                               stderr=subprocess.PIPE).decode().strip()
+
+            git('init', '-q')
+            (root / 'tools').mkdir()
+            shutil.copyfile(ROOT / 'tools/check_factory.py', root / 'tools/check_factory.py')
+            (root / '.github/workflows').mkdir(parents=True)
+            (root / '.github/workflows/tests.yml').write_text('trusted workflow\n')
+            git('add', '.')
+            git('commit', '-qm', 'trusted policy')
+            base = git('rev-parse', 'HEAD')
+            attacks = {
+                'match': ('src/main/f.c', 'void f(void) {}\n'),
+                'checker': ('tools/gate3.py', 'raise SystemExit(0)\n'),
+                'guard': ('tools/check_factory.py', 'raise SystemExit(0)\n'),
+                'workflow': ('.github/workflows/tests.yml', 'weakened\n'),
+                'imports': ('tools/baseline_file.py', 'weakened\n'),
+                'config': ('tools/requirements.txt', 'weakened\n'),
+                'paths': ('tools/protected_paths.py', 'PATTERNS = ()\n'),
+                'settings': ('.codex/hooks.json', '{}\n'),
+                'baseline': ('tools/fake_match_baseline.txt', 'laundered\n'),
+                'delete-guard': ('tools/check_factory.py', None),
+                'delete-workflow': ('.github/workflows/tests.yml', None),
+            }
+            for label, (name, content) in attacks.items():
+                with self.subTest(attack=label):
+                    git('checkout', '-q', '--detach', base)
+                    path = root / name
+                    if content is None:
+                        path.unlink()
+                    else:
+                        path.parent.mkdir(parents=True, exist_ok=True)
+                        path.write_text(content)
+                    git('add', '-A')
+                    git('commit', '-qm', label)
+                    head = git('rev-parse', 'HEAD')
+                    git('checkout', '-q', '--detach', base)
+                    event = root / 'event.json'
+                    for branch, expected in [('factory/batch', int(label != 'match')),
+                                             ('worker/reviewed', 0)]:
+                        event.write_text(json.dumps({'pull_request': {'base': {'sha': base},
+                                                                    'head': {'sha': head, 'ref': branch}}}))
+                        result = subprocess.run([sys.executable, 'tools/check_factory.py', '--event', str(event)],
+                                                cwd=root, capture_output=True, text=True)
+                        self.assertEqual(result.returncode, expected, result.stdout + result.stderr)
