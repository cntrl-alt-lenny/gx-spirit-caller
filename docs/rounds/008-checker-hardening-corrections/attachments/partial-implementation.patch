index 000000000..4080f3917
--- /dev/null
+++ b/tests/test_semantic_fake_matches.py
@@ -0,0 +1,97 @@
+"""Round 008 compiler-valid misses, syntax controls, and adversarial attempts."""
+from __future__ import annotations
+
+import contextlib
+import io
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+import check_fake_matches as cfm  # noqa: E402
+
+CONDITIONS = ('(int)0', '1-1', '-0', r"'\0'", 'NULL', '0.0', '0 && x',
+              '((void)0,0)', 'sizeof(char)-1', '0 == 1', 'ZERO')
+DECLARATIONS = (
+    'void f(void){for(volatile int i=0;i<1;i++) {}}',
+    'typedef int * volatile VPV; void f(void){VPV p;}',
+    '#define DECL(t,n) volatile t n\nvoid f(void){DECL(int,x);}',
+    'void f(void){int a=0,* volatile p=&a;}',
+)
+
+
+class TestSemanticLint(unittest.TestCase):
+    def tree(self, source, headers=None):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        root = Path(temp.name)
+        (root / 'src').mkdir()
+        # A legacy filename is scanned even when not in delinks (inactive TU).
+        (root / 'src/probe.legacy.c').write_text(source)
+        for name, text in (headers or {}).items():
+            path = root / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(text)
+        return root
+
+    def findings(self, source, headers=None):
+        return {f.rule for f in cfm.scan_tree(self.tree(source, headers))}
+
+    def test_constant_false_expressions(self):
+        for condition in CONDITIONS:
+            with self.subTest(condition=condition):
+                source = ('#define NULL ((void*)0)\nenum { ZERO=0 };\n'
+                          f'void f(int x){{do{{}}while({condition});}}')
+                self.assertIn('do-while-zero', self.findings(source))
+
+    def test_volatile_declaration_semantics(self):
+        for source in DECLARATIONS:
+            with self.subTest(source=source):
+                self.assertIn('volatile-local', self.findings(source))
+
+    def test_invalid_syntax_is_a_nonzero_diagnostic(self):
+        root = self.tree('void f(int c){while(c) volatile int x=c;}')
+        out = io.StringIO()
+        with contextlib.redirect_stderr(out):
+            self.assertEqual(cfm.main(['--root', str(root)]), 2)
+        self.assertIn('INPUT ERROR', out.getvalue())
+
+    def test_braced_detection_control(self):
+        self.assertIn('volatile-local', self.findings('void f(int c){while(c){volatile int x=c;}}'))
+
+    def test_adversarial_attempts_and_inactive_branch(self):
+        for source, rule in (
+            ('#define CAT(a,b) a##b\nvoid f(void){CAT(vola,tile) int x;}', 'volatile-local'),
+            ('typedef volatile int V;typedef V W;void f(void){W x;}', 'volatile-local'),
+            ('#define Z(x) ((x)-(x))\nvoid f(void){do{}while(Z(123));}', 'do-while-zero'),
+            ('/* é */ void f(void){do{}while(0);}', 'do-while-zero'),
+            ('void f(void){do{do{}while(0);}while(1);}', 'do-while-zero'),
+            ('#if 0\nvoid f(void){do{}while((int)0);}\n#endif', 'do-while-zero'),
+            ('#if 1\nvoid f(void){}\n#else\nvoid f(void){volatile int x;}\n#endif', 'volatile-local'),
+            ('#define A asm\nvoid f(void){volatile int x;}', 'volatile-local'),
+        ):
+            with self.subTest(source=source):
+                self.assertIn(rule, self.findings(source))
+
+    def test_headers_expand_conditions_types_and_declarations(self):
+        self.assertEqual(self.findings('#include "x.h"\nvoid f(void){D(int,x);do{}while(Z);}',
+                                     {'include/x.h': '#define D(t,n) volatile t n\n#define Z (1-1)\n'}),
+                         {'volatile-local', 'do-while-zero'})
+
+    def test_honest_loops_pointers_and_statement_macros(self):
+        self.assertEqual(self.findings(
+            '#define SAFE(x) do{(x)=0;}while(0)\n'
+            'typedef volatile int V; extern volatile int g;\n'
+            'void f(int n,V *p){V *q=p;extern volatile int other;'
+            'SAFE(n);do{}while(n);do{}while(1);*q=g+other;}'), set())
+
+    def test_missing_header_fails_closed(self):
+        root = self.tree('#include "missing.h"\nvoid f(void){}')
+        with contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(cfm.main(['--root', str(root)]), 2)
+
+    def test_syntax_adapter_keyword_macro_fails_closed(self):
+        root = self.tree('#define asm volatile\nasm int f(void){volatile int x;return x;}')
+        with contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(cfm.main(['--root', str(root)]), 2)
