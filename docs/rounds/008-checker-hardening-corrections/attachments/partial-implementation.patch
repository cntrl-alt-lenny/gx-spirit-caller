@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Base-tree factory policy. Run only from the trusted PR base checkout.
+
+The workflow supplies GITHUB_EVENT_PATH, never proposed configuration. This
+stdlib-only program reads head bytes with git; it never imports or executes
+anything from that tree. All paths outside the minimal shipment set are denied.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def git(root: Path, *args: str) -> bytes:
+    return subprocess.check_output(['git', *args], cwd=root, stderr=subprocess.PIPE)
+
+
+def allowed(path: str) -> bool:
+    return bool(re.fullmatch(r'src/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\.(?:c|cpp|s)', path)
+                or re.fullmatch(r'config/(?:eur|usa|jpn)/arm9/(?:overlays/ov[0-9]+/)?delinks\.txt', path)
+                or path == 'docs/ledger/attempts.tsv')
+
+
+def decide(event: dict, root: Path) -> int:
+    pr = event['pull_request']
+    base, head, branch = pr['base']['sha'], pr['head']['sha'], pr['head']['ref']
+    if not all(isinstance(s, str) and re.fullmatch(r'[0-9a-f]{40}', s) for s in (base, head)):
+        raise ValueError('event requires literal base and head SHAs')
+    if not isinstance(branch, str) or not branch:
+        raise ValueError('event requires head branch')
+    if git(root, 'rev-parse', 'HEAD').decode().strip() != base:
+        raise ValueError('policy must execute at the event base SHA')
+    # Even a non-factory decision requires real event metadata and base code.
+    if not branch.startswith('factory/'):
+        print('check_factory: OK - reviewed branch, factory restriction does not apply')
+        return 0
+    ancestor = git(root, 'merge-base', base, head).decode().strip()
+    paths = git(root, 'diff', '--no-renames', '--name-only', '-z', ancestor, head).split(b'\0')
+    denied = []
+    for raw in filter(None, paths):
+        path = raw.decode('utf-8', errors='strict')
+        # Git mode 120000 is a symlink; 160000 is a submodule. Neither may
+        # turn an allowed filename into another file or executable dependency.
+        entry = git(root, 'ls-tree', head, '--', path)
+        ordinary = not entry or entry.startswith(b'100644 blob ')
+        if not allowed(path) or not ordinary:
+            denied.append(path)
+    for path in denied:
+        print(f'check_factory: DENIED {path!r}')
+    print(f'check_factory: {"FAIL" if denied else "OK"} - {len(denied)} forbidden change(s)')
+    return int(bool(denied))
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--event', required=True, type=Path)
+    args = ap.parse_args(argv)
+    try:
+        return decide(json.loads(args.event.read_text(encoding='utf-8')), ROOT)
+    except (ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError) as exc:
+        print(f'check_factory: INPUT ERROR - {exc}')
+        return 2
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
